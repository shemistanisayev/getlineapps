# Copy to .env for local work. Never commit .env.
# Site (apps/site, Faza 2). Production values are set with:
#   npx wrangler pages secret put RESEND_API_KEY --project-name getlineapps
#   npx wrangler pages secret put FEEDBACK_TO --project-name getlineapps
# Local function test: copy to apps/site/.dev.vars and run pnpm --filter @line/site pages:dev
RESEND_API_KEY=
FEEDBACK_TO=
FEEDBACK_FROM=Line apps <feedback@getlineapps.com>
# Optional site analytics, loaded only after consent
PUBLIC_GTM_ID=
