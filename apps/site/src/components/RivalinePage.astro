---
/**
 * Rivaline landing (/rivaline, /az/rivaline): design/rivaline/Landing.dc.html (+ Tablet, Mobile,
 * which embed it, so its media queries are the spec). Every text comes from
 * src/content/rivaline/<locale>.json and shared/<locale>.json. #finder is the free ad library
 * finder (src/scripts/ad-finder.ts) with the same URL builders as the extension.
 */
import '../styles/rivaline.css';
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import Mark from './Mark.astro';
import { BRANDS } from '@line/ui/brand';
import { contactUrl } from '@line/core/site';
import {
  googleLibraryUrl,
  linkedinLibraryUrl,
  metaLibraryUrl,
  parseFinderQuery,
  tiktokLibraryUrl,
} from '@line/core/rivaline/ads';
import { faqPageJsonLd, softwareApplicationJsonLd } from '@line/site-kit/seo';
import {
  SOURCE_URL,
  fill,
  getRivaline,
  getShared,
  getTool,
  hasLanding,
  localePath,
  type Locale,
} from '../lib/site.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = await getRivaline(locale);
const t = await getShared(locale);
const tool = await getTool('rivaline');
const live = tool.status === 'live' && Boolean(tool.storeUrl);
const other: Locale = locale === 'en' ? 'az' : 'en';
const cta = (campaign: 'audit_cta' | 'faq' | 'footer') =>
  contactUrl({ source: 'rivaline', medium: 'landing', campaign });
const ogImage = '/og/rivaline.png';

const seo = {
  title: c.meta.title,
  description: c.meta.description,
  path: localePath(locale, '/rivaline'),
  image: ogImage,
  imageAlt: c.meta.ogAlt,
  alternates: { en: '/rivaline', az: '/az/rivaline' },
  jsonLd: [
    softwareApplicationJsonLd({
      name: 'Rivaline',
      description: c.meta.description,
      path: '/rivaline',
      image: ogImage,
      storeUrl: tool.storeUrl,
    }),
    faqPageJsonLd(c.faq.items),
  ],
};

const others = (['hitline', 'serpline', 'foldline', 'markline'] as const).map((slug) => ({
  slug,
  ...c.more.tools[slug],
  bright: BRANDS[slug].bright,
  href: hasLanding(slug) ? localePath(locale, `/${slug}`) : null,
}));
const marquee = [
  ...c.marquee.items.map((m) => ({ ...m, dup: false })),
  ...c.marquee.items.map((m) => ({ ...m, dup: true })),
];
const f = c.features;
const tabs = [
  { id: 'st', tab: f.stack },
  { id: 'ad', tab: f.ads },
  { id: 'br', tab: f.brand },
  { id: 'rp', tab: f.report },
] as const;

/** The Brand tab demo's CSS (design: Landing, Brand pane). */
const SCODE = [
  ':root {',
  '  <b>--kova-primary</b>: #2F5D46;',
  '  <b>--kova-font-heading</b>: "Fraunces";',
  '}',
].join('\n');

/** Kova's brand kit (design: Brand, Report). */
const KOVA = ['#2F5D46', '#1E2B24', '#F6F1EA', '#EBC56B', '#DCE5D8'];

/** Icons drawn in the artboard. Status pills always carry one (status colors rule). */
const ICON = {
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  alert: '<path d="M12 6v8"/><path d="M12 18.5h.01"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  out: '<path d="M7 17L17 7M8 7h9v9"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>',
  dropper: '<path d="M14.5 4.5l5 5M17 7l-9.5 9.5L5 19l2.5-2.5L17 7z"/><path d="M12.5 6.5l5 5"/>',
} as const;

// Ad library finder: server-rendered first state (the design default), the island keeps it live.
const fz = c.finder;
const q = parseFinderQuery(fz.default);
const finderLibs = [
  {
    id: 'meta',
    mark: 'meta',
    name: fz.libs.meta,
    href: metaLibraryUrl(q.brand),
    by: q.brand ? fill(fz.searchesBrand, { q: q.brand }) : fz.typeBrand,
  },
  {
    id: 'google',
    mark: 'google',
    name: fz.libs.google,
    href: q.domain
      ? googleLibraryUrl(q.domain)
      : 'https://adstransparency.google.com/?region=anywhere',
    by: q.domain ? fill(fz.searchesDomain, { q: q.domain }) : fz.needsDomain,
  },
  {
    id: 'tiktok',
    mark: 'tiktok',
    name: fz.libs.tiktok,
    href: tiktokLibraryUrl(q.brand),
    by: q.brand ? fill(fz.searchesBrand, { q: q.brand }) : fz.typeBrand,
  },
  {
    id: 'linkedin',
    mark: 'library',
    name: fz.libs.linkedin,
    href: linkedinLibraryUrl(q.brand),
    by: q.brand ? fill(fz.searchesBrand, { q: q.brand }) : fz.typeBrand,
  },
] as const;
const finderTexts = JSON.stringify({
  brand: fz.brand,
  typeAbove: fz.typeAbove,
  searchesBrand: fz.searchesBrand,
  searchesDomain: fz.searchesDomain,
  needsDomain: fz.needsDomain,
  typeBrand: fz.typeBrand,
});
---

<Base locale={locale} seo={seo} page="lp-page rv-page">
  <div class="lp">
    <header class="nav">
      <div class="wrap">
        <a href={localePath(locale, '/rivaline')} class="home" aria-label="Rivaline">
          <Logo brand="rivaline" theme="dark" size={30} label="" />
        </a>
        <nav class="r-navl" aria-label={c.nav.label}>
          <a class="nl" href="#features">
            {c.nav.features}
          </a>
          <a class="nl" href="#finder">
            {c.nav.finder}
          </a>
          <a class="nl" href="#how">
            {c.nav.how}
          </a>
          <a class="nl" href="#privacy">
            {c.nav.privacy}
          </a>
          <a class="nl" href="#faq">
            {c.nav.faq}
          </a>
        </nav>
        <span class="grow"></span>
        <a class="nl lang" href={localePath(other, '/rivaline')} hreflang={other} lang={other}>
          <span aria-hidden="true">{t.switchTo.short}</span>
          <span class="sr-only">{t.switchTo.label}</span>
        </a>
        {live ? (
          <a class="btn btn-p btn-nav" href={tool.storeUrl!} target="_blank" rel="noopener">
            {c.add.nav}
            <svg
              class="arr"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={ICON.arrow}
            />
          </a>
        ) : (
          <span class="btn btn-soon btn-nav">{c.add.soonNav}</span>
        )}
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <span class="glow g1"></span>
        <span class="glow g2"></span>
        <div class="wrap r-hero">
          <div class="hero-copy">
            <span class="rise pill-free" style="animation-delay:.05s">
              <span class="live"></span>
              {c.hero.pill}
            </span>
            <h1 class="disp rise r-h1" style="animation-delay:.15s">
              {c.hero.titleStart} <span class="marker">{c.hero.titleHighlight}</span>
            </h1>
            <p class="lead rise" style="max-width:540px;animation-delay:.3s">
              {c.hero.lead}
            </p>
            <div class="rise hero-ctas" style="animation-delay:.45s">
              {live ? (
                <a class="btn btn-p" href={tool.storeUrl!} target="_blank" rel="noopener">
                  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="11" fill="#FFFFFF" opacity=".25" />
                    <circle cx="12" cy="12" r="4.2" fill="#FFFFFF" />
                    <path
                      d="M12 7.8h9.2M8.4 14.1L3.8 6.1M15.6 14.1l-4.6 8"
                      stroke="#FFFFFF"
                      stroke-width="2"
                    />
                  </svg>
                  {c.add.hero}
                  <svg
                    class="arr"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={ICON.arrow}
                  />
                </a>
              ) : (
                <span class="btn btn-soon">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                  {c.add.soonHero}
                </span>
              )}
              <a class="btn btn-o" href="#finder">
                {c.hero.secondary}
              </a>
            </div>
            <ul class="rise calls" aria-label={c.hero.trustLabel} style="animation-delay:.6s">
              {c.hero.trust.map((x) => (
                <li class="call">
                  <span class="ci">
                    <svg
                      width="11"
                      height="11"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#1A2E05"
                      stroke-width="3.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={ICON.check}
                    />
                  </span>
                  {x}
                </li>
              ))}
            </ul>
          </div>

          <div class="rise hero-art" style="animation-delay:.35s">
            <div class="mock" role="img" aria-label={c.hero.mock.label}>
              <div class="mbar" aria-hidden="true">
                <span class="dot" style="background:#FF5F57"></span>
                <span class="dot" style="background:#FEBC2E"></span>
                <span class="dot" style="background:#28C840"></span>
                <span class="mono murl">{c.hero.mock.url}</span>
              </div>
              <div class="r-mockb" aria-hidden="true">
                <div class="r-site kova">
                  <span class="kova-logo">
                    <i></i>kova
                  </span>
                  <span class="kova-h">{c.hero.mock.siteTitle}</span>
                  <span class="kova-btn">{c.hero.mock.siteButton}</span>
                  <span class="kova-art">
                    <span class="a1"></span>
                    <span class="a2"></span>
                    <span class="a3"></span>
                  </span>
                </div>
                <div class="mpanel">
                  <div class="mhead">
                    <div class="mlogo">
                      <Logo brand="rivaline" theme="light" size={18} label="" />
                    </div>
                    <div class="mtabs">
                      <span class="mtab on">
                        {c.hero.mock.tabs.stack} <b>13</b>
                      </span>
                      <span class="mtab">
                        {c.hero.mock.tabs.ads} <b>4</b>
                      </span>
                      <span class="mtab">
                        {c.hero.mock.tabs.brand} <b>5</b>
                      </span>
                    </div>
                  </div>
                  <div class="mbody">
                    <div class="mhero">
                      <span class="mh-host">{c.hero.mock.host}</span>
                      <span class="disp mh-t">{c.hero.mock.title}</span>
                    </div>
                    <div class="mlist">
                      {c.hero.mock.rows.map((r, i) => (
                        <div class="mrow seq" style={`animation-delay:${0.2 + i * 0.25}s`}>
                          <Mark name={r.mark} size={22} />
                          {r.name}
                          <span class="id">{r.id}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="float r-float" aria-hidden="true">
              <div class="between">
                <span class="fl-eye">{c.hero.kit.eyebrow}</span>
                <span class="fl-hint">{c.hero.kit.hint}</span>
              </div>
              <div class="sw5">
                {KOVA.map((hex) => (
                  <span class="sw" style={`background:${hex}`}>
                    <span>{hex}</span>
                  </span>
                ))}
              </div>
              <span class="fl-fonts">
                <b>{c.hero.kit.headingFont}</b> {c.hero.kit.headings}, <b>{c.hero.kit.bodyFont}</b>{' '}
                {c.hero.kit.body}
              </span>
            </div>
            <div class="toast r-toast" aria-hidden="true">
              <span class="t-ic">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={ICON.alert}
                />
              </span>
              <span class="col2">
                <span class="t-eye">{c.hero.toast.eyebrow}</span>
                <span class="t-x">{c.hero.toast.text}</span>
              </span>
            </div>
          </div>
        </div>
        <div class="wrap marq-w">
          <span class="marq-t">{c.marquee.title}</span>
          <div class="marq">
            <ul class="marq-in">
              {marquee.map((m) => (
                <li class="tag" aria-hidden={m.dup ? 'true' : undefined}>
                  <Mark name={m.mark} size={30} />
                  {m.label}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="problem" class="sec-white">
        <div class="wrap col48">
          <div class="r-stack head-row">
            <div class="col16" style="max-width:640px">
              <span class="eyebrow">{c.problem.eyebrow}</span>
              <h2 class="disp h2">{c.problem.title}</h2>
            </div>
            <p class="lead" style="max-width:360px">
              {c.problem.lead}
            </p>
          </div>
          <div class="r-3 grid3">
            <div class="card lift prob">
              <div class="mini mini-code mono" aria-hidden="true">
                <span>&lt;script src="/cdn/shop/theme.js"&gt;</span>
                <span>&lt;script src="/cdn/shop/cart.js"&gt;</span>
                <span class="hlline">
                  &lt;script src="connect.facebook.net/<b>fbevents.js</b>"&gt;
                </span>
                <span>&lt;script src="/cdn/shop/vendor.js"&gt;</span>
                <span>&lt;script src="/cdn/shop/reviews.js"&gt;</span>
                <span>&lt;script src="/cdn/shop/quiz.js"&gt;</span>
              </div>
              <span class="num">01</span>
              <h3 class="disp prob-t">{c.problem.cards[0]!.title}</h3>
              <p class="prob-x">{c.problem.cards[0]!.text}</p>
            </div>
            <div class="card lift prob">
              <div class="mini mini-libs" aria-hidden="true">
                {(['meta', 'google', 'tiktok', 'library'] as const).map((mk, i) => (
                  <span class="mlib">
                    <Mark name={mk} size={20} />
                    <span class="typing" style={`animation-delay:${i * 0.5}s`}>
                      Kova
                    </span>
                    <span class="caret" />
                  </span>
                ))}
              </div>
              <span class="num">02</span>
              <h3 class="disp prob-t">{c.problem.cards[1]!.title}</h3>
              <p class="prob-x">{c.problem.cards[1]!.text}</p>
            </div>
            <div class="card lift prob">
              <div class="mini" aria-hidden="true">
                <div class="drops">
                  <span style="background:#2F5D46"></span>
                  <span style="background:#EBC56B"></span>
                  <span style="background:#1E2B24"></span>
                  <span style="background:#DCE5D8;box-shadow:inset 0 0 0 1px #C9D3C5"></span>
                </div>
                <span class="dropper">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={ICON.dropper}
                  />
                </span>
              </div>
              <span class="num">03</span>
              <h3 class="disp prob-t">{c.problem.cards[2]!.title}</h3>
              <p class="prob-x">{c.problem.cards[2]!.text}</p>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="sec-plain">
        <div class="wrap">
          <div class="col16 center" style="margin-bottom:40px">
            <span class="eyebrow">{f.eyebrow}</span>
            <h2 class="disp h2" style="max-width:900px">
              {f.title}
            </h2>
          </div>
          <div class="showcase">
            {tabs.map((x, i) => (
              <input
                class="tabs-in"
                type="radio"
                name="rv-tabs"
                id={`tb-${x.id}`}
                checked={i === 0}
              />
            ))}
            <div class="tbar-w">
              <div class="tbar" role="group" aria-label={f.tabsLabel}>
                {tabs.map((x) => (
                  <label for={`tb-${x.id}`}>{x.tab.label}</label>
                ))}
              </div>
            </div>
            <div class="panes">
              {tabs.map((x) => (
                <div class={`pane p-${x.id}`} data-r="pane">
                  <div class="col20">
                    <span class="eyebrow">{x.tab.label}</span>
                    <h3 class="disp pane-t">{x.tab.title}</h3>
                    <p class="lead pane-l">{x.tab.lead}</p>
                    <ul class="buls">
                      {x.tab.bullets.map((b) => (
                        <li class="bul">
                          <span class="bi">
                            <svg
                              width="12"
                              height="12"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="3"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                              set:html={ICON.check}
                            />
                          </span>
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="stage" aria-hidden="true">
                    {x.id === 'st' && (
                      <div class="sbox">
                        <div class="sgrp">{f.stack.demo.advertising}</div>
                        <div class="srow">
                          <Mark name="meta" size={28} />
                          <span class="col0">
                            <span>Meta Pixel</span>
                            <span class="mono sid">418273650912345</span>
                          </span>
                          <span class="pill mute ml">Script</span>
                        </div>
                        <div class="srow">
                          <Mark name="pinterest" size={28} />
                          <span class="col0">
                            <span>Pinterest Tag</span>
                            <span class="mono sid">2612345678901</span>
                          </span>
                          <span class="pill mute ml">Cookie</span>
                        </div>
                        <div class="sgrp line">{f.stack.demo.emailChat}</div>
                        <div class="srow">
                          <Mark name="mailchimp" size={28} />
                          <span>Mailchimp</span>
                          <span class="pill mute ml">Script</span>
                        </div>
                        <div class="srow">
                          <Mark name="intercom" size={28} />
                          <span>Intercom</span>
                          <span class="pill mute ml">Global</span>
                        </div>
                        <div class="snf">
                          <svg
                            width="15"
                            height="15"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            set:html={ICON.alert}
                          />
                          <span>
                            <b>{f.stack.demo.notFoundStrong}</b> {f.stack.demo.notFound}
                          </span>
                        </div>
                      </div>
                    )}
                    {x.id === 'ad' && (
                      <div class="sbox">
                        {(
                          [
                            ['meta', 'Meta Ad Library', f.ads.demo.searchesBrand],
                            ['google', 'Google Ads Transparency', f.ads.demo.searchesDomain],
                            ['tiktok', 'TikTok Ad Library', f.ads.demo.searchesBrand],
                            ['library', 'LinkedIn Ad Library', f.ads.demo.searchesBrand],
                          ] as const
                        ).map(([mk, name, by], i) => (
                          <div class={i === 0 ? 'srow first' : 'srow'}>
                            <Mark name={mk} size={28} />
                            <span class="col0">
                              <span>{name}</span>
                              <span class="sby">{by}</span>
                            </span>
                            <span class="go">
                              <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.4"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                set:html={ICON.out}
                              />
                            </span>
                          </div>
                        ))}
                        <div class="sall">{f.ads.demo.openAll}</div>
                      </div>
                    )}
                    {x.id === 'br' && (
                      <div class="sbox pad">
                        <div class="sw5">
                          {KOVA.map((hex) => (
                            <span class="sw tall" style={`background:${hex}`}>
                              <span>{hex}</span>
                            </span>
                          ))}
                        </div>
                        <div class="frow">
                          <span>{f.brand.demo.headings}</span>
                          <b>Fraunces 600</b>
                        </div>
                        <div class="frow">
                          <span>{f.brand.demo.body}</span>
                          <b>DM Sans 400</b>
                        </div>
                        <pre class="mono scode" set:html={SCODE} />
                      </div>
                    )}
                    {x.id === 'rp' && (
                      <div class="sbox rp">
                        <div class="between">
                          <Logo brand="rivaline" theme="light" size={20} label="" />
                          <span class="rp-date">{f.report.demo.date}</span>
                        </div>
                        <div>
                          <span class="rp-eye">{f.report.demo.eyebrow}</span>
                          <div class="disp rp-host">example.com</div>
                        </div>
                        <div class="rp-tiles">
                          <div>
                            <b class="disp">13</b>
                            <span>{f.report.demo.tools}</span>
                          </div>
                          <div>
                            <b class="disp">8</b>
                            <span>{f.report.demo.categories}</span>
                          </div>
                          <div>
                            <b class="disp">4</b>
                            <span>{f.report.demo.pixels}</span>
                          </div>
                          <div class="warn-t">
                            <b class="disp">3</b>
                            <span>
                              <svg
                                width="9"
                                height="9"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                set:html={ICON.alert}
                              />
                              {f.report.demo.gaps}
                            </span>
                          </div>
                        </div>
                        <div class="rp-rows">
                          {f.report.demo.rows.map((r) => (
                            <>
                              <span class="pill bad rp-pill">
                                <svg
                                  width="8"
                                  height="8"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="3"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  set:html={ICON.alert}
                                />
                                {f.report.demo.high}
                              </span>
                              <span>
                                <b>{r.strong}</b> {r.text}
                              </span>
                            </>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="finder" class="sec-white">
        <div class="wrap">
          <div class="finder" data-ad-finder data-texts={finderTexts}>
            <div class="col14 fz-head">
              <span class="eyebrow">{fz.eyebrow}</span>
              <h2 class="disp h2 fz-t">{fz.title}</h2>
              <p class="lead fz-l">{fz.lead}</p>
            </div>
            <label class="fin">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                aria-hidden="true"
                set:html={ICON.search}
              />
              <span class="sr-only">{fz.label}</span>
              <input
                type="text"
                value={fz.default}
                placeholder={fz.placeholder}
                autocomplete="off"
                spellcheck="false"
                data-finder-input
              />
              <span class="pill mute fin-pill" aria-live="polite" data-finder-brand>
                {fill(fz.brand, { brand: q.brand || fz.typeAbove })}
              </span>
            </label>
            <ul class="r-4 libs">
              {finderLibs.map((l) => (
                <li>
                  <a class="lib" href={l.href} target="_blank" rel="noopener" data-lib={l.id}>
                    <Mark name={l.mark} size={40} />
                    <span class="col4">
                      <span class="lib-n">{l.name}</span>
                      <span class="lib-by" data-by>
                        {l.by}
                      </span>
                    </span>
                    <span class="open">
                      {fz.open}
                      <span class="sr-only">({fz.opensNewTab})</span>
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        set:html={ICON.out}
                      />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="fz-note">{fz.tiktokNote}</p>
            <div class="r-stack fz-band">
              <span>{fz.band}</span>
              {live ? (
                <a class="btn btn-p btn-band" href={tool.storeUrl!} target="_blank" rel="noopener">
                  {c.add.band}
                  <svg
                    class="arr"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={ICON.arrow}
                  />
                </a>
              ) : (
                <span class="btn btn-soon-l btn-band">{c.add.soonNav}</span>
              )}
            </div>
          </div>
        </div>
      </section>

      <section id="how" class="sec-plain">
        <div class="wrap">
          <div class="col16" style="margin-bottom:48px">
            <span class="eyebrow">{c.how.eyebrow}</span>
            <h2 class="disp h2">{c.how.title}</h2>
          </div>
          <div class="r-3 grid3" style="position:relative">
            <span class="dash" aria-hidden="true"></span>
            {c.how.steps.map((s, i) => (
              <div class="card step">
                <span class="stepn disp">{i + 1}</span>
                <div class="col8">
                  <h3 class="disp" style="font-size:20px">
                    {s.title}
                  </h3>
                  <p class="step-x">
                    {s.text}
                    {s.keys && (
                      <>
                        {' '}
                        {s.keys.map((k) => (
                          <>
                            <kbd class="kbd">{k}</kbd>{' '}
                          </>
                        ))}
                      </>
                    )}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="report" class="night sec-audit">
        <span class="glow g3"></span>
        <span class="glow g4"></span>
        <div class="wrap r-1 grid-audit">
          <div class="col22">
            <span class="eyebrow" style="color:var(--lime)">
              {c.report.eyebrow}
            </span>
            <h2 class="disp h2 audit-t">
              {c.report.titleStart} <span style="color:var(--lime)">{c.report.titleHighlight}</span>{' '}
              {c.report.titleEnd}
            </h2>
            <p class="lead soft" style="max-width:560px">
              {c.report.text}
            </p>
            <div class="audit-cta">
              <a class="btn btn-l" href={cta('audit_cta')}>
                {c.report.cta}
                <svg
                  class="arr"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={ICON.arrow}
                />
              </a>
              <span class="from">
                {c.report.from} <u>{t.ownerName}</u>
              </span>
            </div>
          </div>
          <div class="paper-w r-paper" aria-hidden="true">
            <div class="paper2"></div>
            <div class="paper">
              <div class="between">
                <Logo brand="rivaline" theme="light" size={24} label="" />
                <span class="pp-date">{c.report.paper.date}</span>
              </div>
              <div>
                <span class="pp-eye">{c.report.paper.eyebrow}</span>
                <div class="disp pp-host">{c.report.paper.host}</div>
              </div>
              <div class="pp-tiles">
                <div class="pt-n">
                  <b class="disp">13</b>
                  <div>{c.report.paper.tools}</div>
                </div>
                <div class="pt-w">
                  <b class="disp">3</b>
                  <div>
                    <svg
                      width="11"
                      height="11"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={ICON.alert}
                    />
                    {c.report.paper.gaps}
                  </div>
                </div>
              </div>
              <div class="pp-rows">
                {c.report.paper.rows.map((r) => (
                  <div class="pp-row">
                    <span class={`pill ${r.tone} pp-pill`}>
                      <svg
                        width="8"
                        height="8"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={ICON.alert}
                      />
                      {r.label}
                    </span>
                    <span>
                      <b>{r.strong}</b> {r.text}
                    </span>
                  </div>
                ))}
              </div>
              <div class="pp-sw">
                {KOVA.map((hex) => (
                  <span style={`background:${hex}`} />
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="privacy" class="priv">
        <div class="wrap r-1 grid-priv">
          <div class="col16">
            <span class="eyebrow" style="color:#1A2E05">
              {c.privacy.eyebrow}
            </span>
            <h2 class="disp h2 priv-t">{c.privacy.title}</h2>
          </div>
          <div class="r-2 grid2s">
            {c.privacy.items.map((x) => (
              <div class="pv">
                <span class="ic" aria-hidden="true">
                  {x.icon === 'server' && (
                    <svg
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="3" y="4" width="18" height="7" rx="2" />
                      <rect x="3" y="13" width="18" height="7" rx="2" />
                      <path d="M3 3l18 18" />
                    </svg>
                  )}
                  {x.icon === 'lock' && (
                    <svg
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="5" y="11" width="14" height="10" rx="2" />
                      <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    </svg>
                  )}
                  {x.icon === 'chart' && (
                    <svg
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M3 3v18h18" />
                      <path d="M7 15l4-4 3 3 5-6" />
                      <path d="M4 4l16 16" />
                    </svg>
                  )}
                  {x.icon === 'code' && (
                    <svg
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M8 7l-5 5 5 5M16 7l5 5-5 5" />
                    </svg>
                  )}
                </span>
                <b class="disp pv-t">{x.title}</b>
                <span class="pv-x">{x.text}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="faq" class="sec-plain">
        <div class="wrap r-1 grid-faq">
          <div class="col16 faq-side" data-r="sticky">
            <span class="eyebrow">{c.faq.eyebrow}</span>
            <h2 class="disp h2 faq-t">{c.faq.title}</h2>
            <p class="faq-ask">
              {c.faq.askBefore}{' '}
              <a class="ask" href={cta('faq')}>
                {c.faq.askLink}
              </a>
            </p>
          </div>
          <div class="faq">
            {c.faq.items.map((x, i) => (
              <details open={i === 0}>
                <summary>
                  {x.q}
                  <span class="pm" aria-hidden="true">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.8"
                      stroke-linecap="round"
                    >
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </span>
                </summary>
                <p>{x.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="night sec-more">
        <div class="wrap">
          <div class="col16" style="margin-bottom:40px">
            <span class="eyebrow" style="color:#67E8F9">
              {c.more.eyebrow}
            </span>
            <h2 class="disp h2 more-t">{c.more.title}</h2>
          </div>
          <div class="r-4 grid4">
            {others.map((o) =>
              o.href ? (
                <a class="tool" style={`--c:${o.bright}`} href={o.href}>
                  <Logo brand={o.slug} theme="dark" size={30} />
                  <span class="soft tool-x">{o.text}</span>
                  <span class="go">
                    {o.open}
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={ICON.arrow}
                    />
                  </span>
                </a>
              ) : (
                <div class="tool" style={`--c:${o.bright}`}>
                  <Logo brand={o.slug} theme="dark" size={30} />
                  <span class="soft tool-x">{o.text}</span>
                  <span class="go soon-go">{t.status.soon}</span>
                </div>
              ),
            )}
          </div>
        </div>
      </section>
    </main>

    <footer class="night lp-foot">
      <div class="wrap r-foot">
        <Logo brand="rivaline" theme="dark" size={26} />
        <span>
          {c.footer.builtBy}{' '}
          <a class="owner" href={cta('footer')}>
            {t.ownerName}
          </a>
        </span>
        <span class="grow"></span>
        <a class="nl" href={localePath(locale, '/')}>
          {t.footer.allTools}
        </a>
        <a class="nl" href={localePath(locale, '/privacy/rivaline')}>
          {c.footer.privacy}
        </a>
        <a class="nl" href={SOURCE_URL}>
          {c.footer.source}
        </a>
        {Boolean((import.meta.env.PUBLIC_GTM_ID as string | undefined)?.trim()) && (
          <button type="button" class="nl" data-cookie-settings>
            {t.footer.cookies}
          </button>
        )}
      </div>
    </footer>
  </div>
</Base>

<script>
  import { mountAdFinder } from '../scripts/ad-finder.ts';
  import { initFaq } from '../scripts/faq.ts';
  initFaq(document);
  document.querySelectorAll<HTMLElement>('[data-ad-finder]').forEach(mountAdFinder);
</script>
