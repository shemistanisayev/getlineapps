---
/**
 * Hitline landing (/hitline, /az/hitline): design/hitline/Landing.dc.html (+ Tablet, Mobile).
 * Every text comes from src/content/hitline/<locale>.json and shared/<locale>.json.
 */
import '../styles/hitline.css';
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import Pf from './Pf.astro';
import ReportMock from './ReportMock.astro';
import { BRANDS } from '@line/ui/brand';
import { contactUrl } from '@line/core/site';
import { faqPageJsonLd, softwareApplicationJsonLd } from '@line/site-kit/seo';
import {
  SOURCE_URL,
  getHitline,
  getShared,
  getTool,
  hasLanding,
  localePath,
  type Locale,
} from '../lib/site.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = await getHitline(locale);
const t = await getShared(locale);
const tool = await getTool('hitline');
const live = tool.status === 'live' && Boolean(tool.storeUrl);
const other: Locale = locale === 'en' ? 'az' : 'en';
const cta = (campaign: 'audit_cta' | 'faq' | 'footer') =>
  contactUrl({ source: 'hitline', medium: 'landing', campaign });
const samplePdf = '/hitline/sample-audit.pdf';
const ogImage = '/og/hitline.png';

const seo = {
  title: c.meta.title,
  description: c.meta.description,
  path: localePath(locale, '/hitline'),
  image: ogImage,
  imageAlt: c.meta.ogAlt,
  alternates: { en: '/hitline', az: '/az/hitline' },
  jsonLd: [
    softwareApplicationJsonLd({
      name: 'Hitline',
      description: c.meta.description,
      path: '/hitline',
      image: ogImage,
      storeUrl: tool.storeUrl,
    }),
    faqPageJsonLd(c.faq.items),
  ],
};

const others = (['serpline', 'rivaline', 'foldline', 'markline'] as const).map((slug) => ({
  slug,
  ...c.more.tools[slug],
  bright: BRANDS[slug].bright,
  href: hasLanding(slug) ? localePath(locale, `/${slug}`) : null,
}));
const tabs = [
  { id: 'ev', key: 'events' },
  { id: 'gt', key: 'gtm' },
  { id: 'co', key: 'consent' },
  { id: 'at', key: 'attribution' },
  { id: 'pl', key: 'plan' },
] as const;
const f = c.features;
const planTotal = f.plan.demo.bars.reduce((n, b) => n + b.n, 0) || 1;
const barColors = ['#12B76A', '#F04438', '#F79009'];
const rows = [...c.hero.rows, ...c.hero.rows];
const marquee = [...c.marquee.items, ...c.marquee.items];
---

<Base locale={locale} seo={seo} page="lp-page">
  <div class="lp">
    <dialog class="sa" id="sample-audit" aria-labelledby="sa-title">
      <div class="sa-box">
        <div class="sa-head">
          <div class="sa-t">
            <span class="eyebrow">{c.sample.eyebrow}</span>
            <span id="sa-title" class="disp">
              {c.sample.title}
            </span>
          </div>
          <button type="button" class="sa-x" data-close aria-label={c.sample.close}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>
        <div class="sa-paper">
          <ReportMock />
        </div>
        <div class="sa-foot">
          <span class="sa-note">{c.sample.note}</span>
          <a class="btn btn-p sa-dl" href={samplePdf} download>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>
            </svg>
            {c.sample.download}
          </a>
        </div>
      </div>
    </dialog>

    <header class="nav">
      <div class="wrap">
        <a href={localePath(locale, '/hitline')} class="home" aria-label="Hitline">
          <Logo brand="hitline" theme="dark" size={30} label="" />
        </a>
        <nav class="r-navl" aria-label={c.nav.label}>
          <a class="nl" href="#features">
            {c.nav.features}
          </a>
          <a class="nl" href="#how">
            {c.nav.how}
          </a>
          <a class="nl" href="#privacy">
            {c.nav.privacy}
          </a>
          <a class="nl" href="#faq">
            {c.nav.faq}
          </a>
        </nav>
        <span class="grow"></span>
        <a class="nl lang" href={localePath(other, '/hitline')} hreflang={other} lang={other}>
          <span aria-hidden="true">{t.switchTo.short}</span>
          <span class="sr-only">{t.switchTo.label}</span>
        </a>
        {live ? (
          <a class="btn btn-p btn-nav" href={tool.storeUrl!} target="_blank" rel="noopener">
            {c.add.nav}
            <svg
              class="arr"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        ) : (
          <span class="btn btn-soon btn-nav">{c.add.soonNav}</span>
        )}
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <span class="glow g1"></span>
        <span class="glow g2"></span>
        <div class="wrap r-hero">
          <div class="hero-copy">
            <span class="rise chip hero-pill" style="animation-delay:.05s">
              <span class="live-g"></span>
              {c.hero.pill}
            </span>
            <h1 class="disp rise r-h1" style="animation-delay:.15s">
              {c.hero.titleStart} <span class="marker">{c.hero.titleHighlight}</span>{' '}
              {c.hero.titleEnd}
            </h1>
            <p class="lead rise" style="max-width:540px;animation-delay:.3s">
              {c.hero.lead}
            </p>
            <div class="rise hero-ctas" style="animation-delay:.45s">
              {live ? (
                <a class="btn btn-p" href={tool.storeUrl!} target="_blank" rel="noopener">
                  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="11" fill="#FFFFFF" opacity=".25" />
                    <circle cx="12" cy="12" r="4.2" fill="#FFFFFF" />
                    <path
                      d="M12 7.8h9.2M8.4 14.1L3.8 6.1M15.6 14.1l-4.6 8"
                      stroke="#FFFFFF"
                      stroke-width="2"
                    />
                  </svg>
                  {c.add.hero}
                  <svg
                    class="arr"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              ) : (
                <span class="btn btn-soon">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                  {c.add.soonHero}
                </span>
              )}
              <a class="btn btn-g" href={samplePdf} data-sample>
                {c.hero.secondary}
              </a>
            </div>
            <div class="rise trusts" style="animation-delay:.6s">
              {c.hero.trust.map((x) => (
                <span class="trust">
                  <i>
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg>
                  </i>
                  {x}
                </span>
              ))}
            </div>
          </div>
          <div class="rise hero-art" style="animation-delay:.35s" aria-hidden="true">
            <div class="mock">
              <div class="mbar">
                <span class="dot" style="background:#FF5F57"></span>
                <span class="dot" style="background:#FEBC2E"></span>
                <span class="dot" style="background:#28C840"></span>
                <span class="grow"></span>
                <span class="mono mlabel">{c.hero.mockLabel}</span>
              </div>
              <div class="mtabs">
                {c.hero.tabs.map((x, i) => (
                  <span class:list={['mtab', { on: i === 0 }]}>
                    {x.label} <b class:list={{ w: x.warn }}>{x.count}</b>
                  </span>
                ))}
                <span class="grow"></span>
                <span class="pill bad" style="gap:7px">
                  <span class="live" style="width:6px;height:6px"></span>
                  {c.hero.live}
                </span>
              </div>
              <div class="feed">
                <div class="feed-in">
                  {rows.map((r) => (
                    <div class:list={['frow', { bad: r.route === 'bad' }]}>
                      <span class="mono ftime">{r.time}</span>
                      <Pf p={r.platform} label={r.name} />
                      <span class="mono fev">{r.event}</span>
                      {r.route === 'sgtm' ? (
                        <span class="pill pur">
                          <svg
                            width="12"
                            height="12"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <rect x="3" y="4" width="18" height="7" rx="2" />
                            <rect x="3" y="13" width="18" height="7" rx="2" />
                          </svg>
                          {c.hero.routes.sgtm}
                        </span>
                      ) : r.route === 'bad' ? (
                        <span class="pill bad">
                          <svg
                            width="12"
                            height="12"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                          >
                            <path d="M12 6v8" />
                            <path d="M12 18.5h.01" />
                          </svg>
                          {c.hero.routes.bad}
                        </span>
                      ) : (
                        <span class="pill mute">{c.hero.routes[r.route]}</span>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div class="float r-float">
              <div class="float-top">
                <span class="float-ic">
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="4" width="18" height="7" rx="2" />
                    <rect x="3" y="13" width="18" height="7" rx="2" />
                  </svg>
                </span>
                <span class="float-txt">
                  <b>{c.hero.sgtmTitle}</b>
                  <span>{c.hero.sgtmVia}</span>
                </span>
              </div>
              <div class="float-row">
                <Pf p="ga" />
                <Pf p="ads" />
                <Pf p="meta" />
                <Pf p="tt" />
                <span class="grow"></span>
                <span class="pill ok">{c.hero.tags}</span>
              </div>
            </div>
            <div class="toast r-toast">
              <span class="toast-ic">
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                >
                  <path d="M12 6v8" />
                  <path d="M12 18.5h.01" />
                </svg>
              </span>
              <span class="toast-txt">
                <span class="toast-l">{c.hero.issueLabel}</span>
                <span>{c.hero.issueText}</span>
              </span>
            </div>
          </div>
        </div>
        <div class="wrap marq-w">
          <span class="mtitle">{c.marquee.title}</span>
          <div class="marq">
            <div class="marq-in">
              {marquee.map((m, i) => (
                <span class="tag" aria-hidden={i >= c.marquee.items.length ? 'true' : undefined}>
                  <Pf p={m.platform} label={m.label} />
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="sec-problem">
        <div class="wrap col48">
          <div class="r-stack head-row">
            <div class="col16">
              <span class="eyebrow">{c.problem.eyebrow}</span>
              <h2 class="disp h2" style="max-width:640px">
                {c.problem.title}
              </h2>
            </div>
            <p class="lead" style="max-width:420px">
              {c.problem.lead}
            </p>
          </div>
          <div class="r-3 grid3">
            <div class="card lift pcard">
              <div class="mini mini-1" aria-hidden="true">
                <div class="mrow">
                  <Pf p="ga" label={c.problem.mini.ga4Event} />
                  <span class="mono mv ok-t">{c.problem.mini.ga4Value}</span>
                </div>
                <div class="mrow badrow">
                  <Pf p="meta" label={c.problem.mini.metaEvent} />
                  <span class="mono mv bad-t">
                    {c.problem.mini.metaValue} <span class="blinkv">_</span>
                  </span>
                </div>
              </div>
              <span class="num mono">01</span>
              <h3 class="disp ptitle">{c.problem.cards[0]!.title}</h3>
              <p class="ptext">{c.problem.cards[0]!.text}</p>
            </div>
            <div class="card lift pcard">
              <div class="mini mini-2" aria-hidden="true">
                <span class="rej">{c.problem.mini.reject}</span>
                <span class="mut-c">
                  <svg
                    class="arr"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
                <span class="firing fire-ic">
                  <Pf p="tt" />
                </span>
              </div>
              <span class="num mono">02</span>
              <h3 class="disp ptitle">{c.problem.cards[1]!.title}</h3>
              <p class="ptext">{c.problem.cards[1]!.text}</p>
            </div>
            <div class="card lift pcard">
              <div class="mini mini-3" aria-hidden="true">
                <span class="track"></span>
                <span class="travel"></span>
                <span class="mono m-gclid">{c.problem.mini.gclid}</span>
                <span class="mono m-host">{c.problem.mini.host}</span>
                <span class="mono m-ref">{c.problem.mini.referral}</span>
              </div>
              <span class="num mono">03</span>
              <h3 class="disp ptitle">{c.problem.cards[2]!.title}</h3>
              <p class="ptext">{c.problem.cards[2]!.text}</p>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="sec-features">
        <div class="wrap col44">
          <div class="center col16">
            <span class="eyebrow">{f.eyebrow}</span>
            <h2 class="disp h2" style="max-width:760px">
              {f.title}
            </h2>
          </div>
          <div class="tabs">
            {tabs.map((x, i) => (
              <input
                class="tabs-in"
                type="radio"
                name="tb"
                id={`tb-${x.id}`}
                checked={i === 0}
                aria-label={f[x.key].label}
              />
            ))}
            <div class="tbar-w">
              <div class="tbar" role="presentation">
                {tabs.map((x) => (
                  <label for={`tb-${x.id}`}>{f[x.key].label}</label>
                ))}
              </div>
            </div>
            <div class="panes">
              {tabs.map((x) => {
                const tab = f[x.key];
                return (
                  <div class={`pane p-${x.id}`} data-r="pane">
                    <div class="col18">
                      <span class="eyebrow">{tab.eyebrow}</span>
                      <h3 class="disp h3">{tab.title}</h3>
                      <p class="lead" style="font-size:16.5px">
                        {tab.lead}
                      </p>
                      <ul class="buls">
                        {tab.bullets.map((b) => (
                          <li class="bul">
                            <span>
                              <svg
                                width="12"
                                height="12"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                              >
                                <path d="M5 12.5l4.5 4.5L19 7.5" />
                              </svg>
                            </span>
                            <span>{b}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="stage" aria-hidden="true">
                      {x.key === 'events' && (
                        <div class="mock" style="width:100%;max-width:560px">
                          <div class="ev-head">
                            <span class="mono" style="font-size:18px;font-weight:600">
                              {f.events.demo.event}
                            </span>
                            <Pf p="ga" label={f.events.demo.platform} />
                            <span class="pill pur">
                              <svg
                                width="12"
                                height="12"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              >
                                <rect x="3" y="4" width="18" height="7" rx="2" />
                                <rect x="3" y="13" width="18" height="7" rx="2" />
                              </svg>
                              {f.events.demo.via}
                            </span>
                          </div>
                          {f.events.demo.params.map((p, j) => (
                            <div class="seq prow" style={`animation-delay:${j * 0.25}s`}>
                              <span class="mono pk">{p.k}</span>
                              <span class="pv-v">{p.v}</span>
                            </div>
                          ))}
                          <div class="seq ev-issue" style="animation-delay:1.3s">
                            <span style="color:#D92D20">
                              <svg
                                width="12"
                                height="12"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="3"
                                stroke-linecap="round"
                              >
                                <path d="M12 6v8" />
                                <path d="M12 18.5h.01" />
                              </svg>
                            </span>
                            <span>
                              <b>{f.events.demo.issueStrong}</b> {f.events.demo.issueText}
                            </span>
                          </div>
                        </div>
                      )}
                      {x.key === 'gtm' && (
                        <div class="sg-card">
                          <div class="sg-top">
                            <span class="disp" style="font-size:22px;font-weight:800">
                              {f.gtm.demo.title}
                            </span>
                            <span class="pill" style="background:#C6F36B;color:#1A2E05">
                              <svg
                                width="12"
                                height="12"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              >
                                <path d="M5 12.5l4.5 4.5L19 7.5" />
                              </svg>
                              {f.gtm.demo.detected}
                            </span>
                          </div>
                          {f.gtm.demo.signals.map((s, j) => (
                            <div class="seq sg-row" style={`animation-delay:${j * 0.4}s`}>
                              <span class="sg-ic">
                                <svg
                                  width="12"
                                  height="12"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="3"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                >
                                  <path d="M5 12.5l4.5 4.5L19 7.5" />
                                </svg>
                              </span>
                              {s}
                            </div>
                          ))}
                        </div>
                      )}
                      {x.key === 'consent' && (
                        <div class="mock" style="width:100%;max-width:520px">
                          <div class="co-head">
                            <span style="font-size:15px;font-weight:700">
                              {f.consent.demo.title}
                            </span>
                            <span class="pill mute">{f.consent.demo.count}</span>
                          </div>
                          {f.consent.demo.rows.map((r) => (
                            <div class:list={['co-row', { hlrow: !r.ok }]}>
                              <Pf p={r.platform} label={r.label} />
                              {r.ok ? (
                                <span class="pill ok">
                                  <svg
                                    width="12"
                                    height="12"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="3"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                  >
                                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                                  </svg>
                                  {r.status}
                                </span>
                              ) : (
                                <span class="pill bad">
                                  <svg
                                    width="12"
                                    height="12"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="3"
                                    stroke-linecap="round"
                                  >
                                    <path d="M12 6v8" />
                                    <path d="M12 18.5h.01" />
                                  </svg>
                                  {r.status}
                                </span>
                              )}
                            </div>
                          ))}
                        </div>
                      )}
                      {x.key === 'attribution' && (
                        <div class="r-at">
                          <div class="at-steps">
                            {f.attribution.demo.steps.map((s, j) => (
                              <div class="seq at-step" style={`animation-delay:${j * 0.3}s`}>
                                <span class:list={['at-n', { bad: j >= 3 }]}>{j + 1}</span>
                                <span class="at-l">{s}</span>
                              </div>
                            ))}
                          </div>
                          <div class="card at-card">
                            {f.attribution.demo.rows.map((r) => (
                              <div class="at-row">
                                <span class="mono at-k">{r.label}</span>
                                {r.cells.map((cell) => (
                                  <span class:list={['pill', cell.ok ? 'ok' : 'bad']}>
                                    {cell.v}
                                  </span>
                                ))}
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                      {x.key === 'plan' && (
                        <div class="mock" style="width:100%;max-width:520px">
                          <div class="pl-head">
                            <span style="font-size:15px;font-weight:700">
                              {f.plan.demo.file}{' '}
                              <span style="color:var(--mut);font-weight:500">
                                {f.plan.demo.count}
                              </span>
                            </span>
                            {f.plan.demo.bars.map((b, j) => (
                              <div class="pl-bar">
                                <span>{b.label}</span>
                                <span class="pl-track">
                                  <span
                                    class="bar-f"
                                    style={`width:${(b.n / planTotal) * 100}%;background:${barColors[j]};animation-delay:${j * 0.2}s`}
                                  />
                                </span>
                                <span>{b.n}</span>
                              </div>
                            ))}
                          </div>
                          {f.plan.demo.rows.map((r) => (
                            <div class="pl-row">
                              <span class="mono" style="font-size:13px;font-weight:600">
                                {r.event}
                              </span>
                              <span class:list={['pill', r.tone]}>
                                <svg
                                  width="12"
                                  height="12"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="3"
                                  stroke-linecap="round"
                                >
                                  <path d="M12 6v8" />
                                  <path d="M12 18.5h.01" />
                                </svg>
                                {r.status}
                              </span>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </section>

      <section id="how" class="sec-how">
        <div class="wrap col48">
          <div class="col16">
            <span class="eyebrow">{c.how.eyebrow}</span>
            <h2 class="disp h2">{c.how.title}</h2>
          </div>
          <div class="r-3 grid3 steps">
            <span class="dash" aria-hidden="true"></span>
            {c.how.steps.map((s, i) => (
              <div class="card lift step">
                <span class="stepn disp" aria-hidden="true">
                  {i + 1}
                </span>
                <h3 class="disp step-t">
                  {s.title}
                  {s.key && (
                    <Fragment>
                      {' '}
                      <kbd class="mono key">{s.key}</kbd>{' '}
                    </Fragment>
                  )}
                  {s.titleEnd}
                </h3>
                <p class="step-x">{s.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="audit" class="night sec-audit">
        <span class="glow g3"></span>
        <span class="glow g4"></span>
        <div class="wrap r-1 audit-grid">
          <div class="col22">
            <span class="eyebrow lime-e">{c.audit.eyebrow}</span>
            <h2 class="disp h2" style="font-size:56px">
              {c.audit.titleStart} <span style="color:#C6F36B">{c.audit.titleHighlight}</span>{' '}
              {c.audit.titleEnd}
            </h2>
            <p class="lead soft" style="max-width:560px">
              {c.audit.lead}
            </p>
            <div class="audit-cta">
              <a class="btn btn-l" href={cta('audit_cta')}>
                {c.audit.cta}
                <svg
                  class="arr"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
              <span class="from">
                {c.audit.from} <u>{t.ownerName}</u>
              </span>
            </div>
          </div>
          <div class="paper-w r-paper" aria-hidden="true">
            <div class="paper2"></div>
            <div class="paper">
              <div class="paper-in">
                <div class="paper-top">
                  <Logo brand="hitline" theme="light" size={24} label="" />
                  <span style="font-size:10.5px;color:#667085">{c.audit.paper.date}</span>
                </div>
                <div>
                  <span class="paper-eye">{c.audit.paper.eyebrow}</span>
                  <div class="disp" style="font-size:24px;font-weight:800">
                    {c.audit.paper.host}
                  </div>
                </div>
                <div class="paper-tiles">
                  <div class="pt hi">
                    <div class="disp">3</div>
                    <div>{c.audit.paper.high}</div>
                  </div>
                  <div class="pt md">
                    <div class="disp">3</div>
                    <div>{c.audit.paper.medium}</div>
                  </div>
                </div>
                <div>
                  {c.audit.paper.items.map((x) => (
                    <div class="paper-row">
                      <span
                        class:list={['pill', x.level === 'high' ? 'bad' : 'warn']}
                        style="height:20px;font-size:10.5px"
                      >
                        {c.audit.paper.levels[x.level]}
                      </span>
                      <span>
                        <b>{x.strong}</b> {x.text}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="privacy" class="priv">
        <div class="wrap r-1 priv-grid">
          <div class="col16">
            <span class="eyebrow" style="color:#1A2E05">
              {c.privacy.eyebrow}
            </span>
            <h2 class="disp h2" style="font-size:48px">
              {c.privacy.title}
            </h2>
          </div>
          <div class="r-2 grid2">
            {c.privacy.items.map((x) => (
              <div class="pv">
                <span class="ic">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {x.icon === 'server' && (
                      <Fragment>
                        <rect x="3" y="4" width="18" height="7" rx="2" />
                        <rect x="3" y="13" width="18" height="7" rx="2" />
                        <path d="M3 3l18 18" />
                      </Fragment>
                    )}
                    {x.icon === 'lock' && (
                      <Fragment>
                        <rect x="4" y="11" width="16" height="10" rx="2" />
                        <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                      </Fragment>
                    )}
                    {x.icon === 'eye' && (
                      <Fragment>
                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
                        <path d="M3 3l18 18" />
                      </Fragment>
                    )}
                    {x.icon === 'code' && <path d="M8 7l-5 5 5 5M16 7l5 5-5 5" />}
                  </svg>
                </span>
                <h3 class="disp pv-t">{x.title}</h3>
                <p class="pv-x">{x.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="faq" class="sec-faq">
        <div class="wrap r-1 faq-grid">
          <div class="col16 faq-side" data-r="sticky">
            <span class="eyebrow">{c.faq.eyebrow}</span>
            <h2 class="disp h2" style="font-size:48px">
              {c.faq.title}
            </h2>
            <p class="lead" style="font-size:16px">
              {c.faq.askBefore}{' '}
              <a class="ask" href={cta('faq')}>
                {c.faq.askLink}
              </a>
            </p>
          </div>
          <div class="faq">
            {c.faq.items.map((x, i) => (
              <details open={i === 0}>
                <summary>
                  {x.q}
                  <span class="pm" aria-hidden="true">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.8"
                      stroke-linecap="round"
                    >
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </span>
                </summary>
                <p>{x.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="night sec-more">
        <div class="wrap col40" style="position:relative">
          <div class="col16">
            <span class="eyebrow" style="color:#B692F6">
              {c.more.eyebrow}
            </span>
            <h2 class="disp h2" style="font-size:44px">
              {c.more.title}
            </h2>
          </div>
          <div class="r-4 grid4">
            {others.map((o) =>
              o.href ? (
                <a class="tool" style={`--c:${o.bright}`} href={o.href}>
                  <Logo brand={o.slug} theme="dark" size={30} />
                  <span class="tool-x">{o.text}</span>
                  <span class="go">
                    {o.open}
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </span>
                </a>
              ) : (
                <div class="tool" style={`--c:${o.bright}`}>
                  <Logo brand={o.slug} theme="dark" size={30} />
                  <span class="tool-x">{o.text}</span>
                  <span class="go soon-go">{t.status.soon}</span>
                </div>
              ),
            )}
          </div>
        </div>
      </section>
    </main>

    <footer class="night lp-foot">
      <div class="wrap r-foot">
        <Logo brand="hitline" theme="dark" size={26} />
        <span>
          {c.footer.builtBy}{' '}
          <a class="owner" href={cta('footer')}>
            {t.ownerName}
          </a>
        </span>
        <span class="grow"></span>
        <a class="nl" href={localePath(locale, '/')}>
          {t.footer.allTools}
        </a>
        <a class="nl" href={localePath(locale, '/privacy/hitline')}>
          {c.footer.privacy}
        </a>
        <a class="nl" href={SOURCE_URL}>
          {c.footer.source}
        </a>
        {Boolean((import.meta.env.PUBLIC_GTM_ID as string | undefined)?.trim()) && (
          <button type="button" class="nl" data-cookie-settings>
            {t.footer.cookies}
          </button>
        )}
      </div>
    </footer>
  </div>
</Base>

<script>
  import { initFaq } from '../scripts/faq.ts';
  initFaq(document);

  // Sample audit modal: a native <dialog> (focus, Esc and the backdrop come for free).
  // Without JavaScript the button simply opens the sample PDF.
  const dialog = document.getElementById('sample-audit') as HTMLDialogElement | null;
  document.querySelectorAll<HTMLAnchorElement>('[data-sample]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (!dialog?.showModal) return;
      e.preventDefault();
      dialog.showModal();
    }),
  );
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
