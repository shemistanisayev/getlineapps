---
/** Line icons from the hub and privacy artboards. */
const paths = {
  arrow: ['M5 12h14M13 6l6 6-6 6'],
  check: ['M5 12l5 5 9-10'],
  lock: ['M8 11V8a4 4 0 0 1 8 0v3'],
  doc: ['M7 3h7l5 5v13H7z', 'M14 3v5h5M10 13h6M10 17h6'],
  gift: [
    'M20 12v9H4v-9M2 7h20v5H2zM12 21V7M12 7H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7z',
  ],
  click: ['M9 11l-4 9 3-1 2 3 3-7', 'M14 4l1.5 4.5L20 10l-4.5 1.5L14 16l-1.5-4.5L8 10l4.5-1.5z'],
  plus: ['M12 5v14M5 12h14'],
  info: ['M12 8h.01M11 12h1v5h1'],
  chrome: ['M12 8.5h8.2M8.9 13.8L4.8 6.7M15 13.8l-4.1 7.1'],
  clock: ['M12 7v5l3 2'],
  plant: [],
  circle: [],
} as const;
export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  class?: string;
}
const { name, size = 18, stroke = 2.4, class: cls } = Astro.props;
const circle = name === 'info' || name === 'clock' || name === 'circle';
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox={name === 'plant' ? '0 0 48 48' : '0 0 24 24'}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'lock' && <rect x="5" y="11" width="14" height="10" rx="2" />}
  {circle && <circle cx="12" cy="12" r="9" />}
  {name === 'chrome' && (
    <Fragment>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="3.5" />
    </Fragment>
  )}
  {name === 'plant' && (
    <Fragment>
      <path d="M24 40V22" />
      <path d="M24 26c-8 0-12-5-12-12 8 0 12 5 12 12zM24 22c0-7 4-12 12-12 0 7-4 12-12 12z" />
      <path d="M14 40h20" />
    </Fragment>
  )}
  {paths[name].map((d) => (
    <path d={d} />
  ))}
</svg>
