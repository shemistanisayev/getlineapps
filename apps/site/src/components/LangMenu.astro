---
/**
 * Language menu in every header: a button with the current language code that opens a list of
 * the languages this page exists in. Works without JavaScript (<details>); the script only closes
 * it on Escape, an outside click or when another menu opens.
 * Desktop and tablet: a panel under the button. Phone (640 px and less): a full-width sheet
 * under the header with two columns.
 */
import { LANGUAGE_NAMES, localePath, pageLocales, type Locale } from '../lib/site.ts';

interface Props {
  locale: Locale;
  /** This page's path in English, for example "/hitline". */
  path: string;
  /** "Language" in the page language (shared/<locale>.json). */
  label: string;
}
const { locale, path, label } = Astro.props;
const langs = pageLocales(path);
---

<details class="lm" data-lang-menu>
  <summary class="lm-btn" aria-label={`${label}: ${LANGUAGE_NAMES[locale]}`}>
    <svg
      class="lm-globe"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path>
    </svg>
    <span class="lm-code" aria-hidden="true">
      {locale.toUpperCase()}
    </span>
    <svg
      class="lm-chev"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </summary>
  <div class="lm-panel">
    <p class="lm-head">{label}</p>
    <ul class:list={['lm-list', { 'lm-many': langs.length > 4 }]}>
      {langs.map((l) => (
        <li>
          <a
            class="lm-item"
            href={localePath(l, path)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? 'page' : undefined}
          >
            <span class="lm-name">{LANGUAGE_NAMES[l]}</span>
            <span class="lm-tag" aria-hidden="true">
              {l.toUpperCase()}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</details>

<script>
  const menus = () => [...document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu]')];
  const closeAll = (except?: Element) => {
    for (const m of menus()) if (m !== except) m.open = false;
  };
  document.addEventListener('click', (e) => {
    const inside = (e.target as Element | null)?.closest('[data-lang-menu]') ?? undefined;
    closeAll(inside);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = menus().find((m) => m.open);
    if (!open) return;
    open.open = false;
    open.querySelector('summary')?.focus();
  });
</script>

<style>
  .lm {
    position: relative;
    flex: none;
  }
  .lm-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 10px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--soft);
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }
  .lm-btn::-webkit-details-marker {
    display: none;
  }
  .lm-btn:hover,
  .lm[open] .lm-btn {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.32);
    background: rgba(255, 255, 255, 0.06);
  }
  .lm-btn:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 2px;
  }
  .lm-chev {
    transition: transform 0.2s;
  }
  .lm[open] .lm-chev {
    transform: rotate(180deg);
  }
  .lm-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 60;
    width: max-content;
    min-width: 220px;
    max-height: min(70vh, 520px);
    overflow-y: auto;
    padding: 8px;
    border-radius: 14px;
    background: var(--night);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.6);
  }
  .lm-head {
    margin: 0;
    padding: 8px 10px 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .lm-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .lm-many {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 4px;
  }
  .lm-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 40px;
    padding: 8px 10px;
    border-radius: 9px;
    color: var(--soft);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .lm-item:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
  }
  .lm-item:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: -2px;
  }
  .lm-item[aria-current='page'] {
    color: #ffffff;
    background: rgba(198, 243, 107, 0.12);
  }
  .lm-tag {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: rgba(208, 203, 230, 0.7);
  }
  .lm-item[aria-current='page'] .lm-tag {
    color: var(--lime);
  }

  @media (max-width: 640px) {
    .lm-btn {
      height: 34px;
      padding: 0 8px;
    }
    .lm-globe {
      display: none;
    }
    .lm-panel {
      position: fixed;
      top: 68px;
      left: 16px;
      right: 16px;
      width: auto;
      min-width: 0;
      max-height: calc(100vh - 88px);
    }
    .lm-item {
      white-space: normal;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lm-btn,
    .lm-chev {
      transition: none;
    }
  }
</style>
