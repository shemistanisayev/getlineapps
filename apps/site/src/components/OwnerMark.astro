---
/** The owner's logomark from shamistanisayev.com (design/hub/Main.dc.html, About and footer). */
interface Props {
  id: string;
  size: number;
  label?: string;
  class?: string;
}
const { id, size, label, class: cls } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 512 512"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#A57CF5"></stop>
      <stop offset=".42" stop-color="#6A3FD0"></stop>
      <stop offset=".72" stop-color="#3F8C8A"></stop>
      <stop offset="1" stop-color="#7FD13B"></stop>
    </linearGradient>
  </defs>
  <rect width="512" height="512" rx="116" fill={`url(#${id})`}></rect>
  <g transform="translate(256 256) scale(.9) translate(-256 -257)">
    <rect x="234" y="66" width="44" height="44" rx="10" fill="#fff"></rect>
    <rect x="234" y="402" width="44" height="48" rx="10" fill="#fff"></rect>
    <path
      d="M 336 150 H 226 A 50 50 0 0 0 176 200 V 206 A 50 50 0 0 0 226 256 H 286 A 50 50 0 0 1 336 306 V 312 A 50 50 0 0 1 286 362 H 176"
      fill="none"
      stroke="#fff"
      stroke-width="44"
      stroke-linejoin="round"
    ></path>
  </g>
</svg>
