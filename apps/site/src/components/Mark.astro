---
/**
 * Brand or topic badge (design/serpline/Mark.dc.html): a tinted rounded square with the mark.
 * Marks come from @line/ui (Simple Icons, CC0), shown only to name what a tool checks.
 * `commoncrawl` has no mark: the "CC" letters on a neutral tint (docs/serpline/PLAN.md G8).
 */
import { MARKS, type MarkName } from '@line/ui/marks';

interface Props {
  name: MarkName | 'commoncrawl';
  size?: number;
  class?: string;
}
const { name, size = 22, class: cls } = Astro.props;
const m = name === 'commoncrawl' ? null : MARKS[name];
const glyph = Math.round(size * 0.62);
const style = `width:${size}px;height:${size}px;border-radius:${Math.round(size * 0.27)}px;background:${m ? m.tint : '#EEEDF3'}${m?.ring ? ';box-shadow:inset 0 0 0 1px rgba(16,24,40,.08)' : ''}`;
---

<span class:list={['mk', cls]} style={style} aria-hidden="true">
  {m ? (
    m.fill ? (
      <svg viewBox="0 0 24 24" width={glyph} height={glyph} fill={m.fill} set:html={m.svg} />
    ) : (
      <svg
        viewBox="0 0 24 24"
        width={glyph}
        height={glyph}
        fill="none"
        stroke={m.stroke}
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={m.svg}
      />
    )
  ) : (
    <span class="mk-cc" style={`font-size:${Math.round(size * 0.38)}px`}>
      CC
    </span>
  )}
</span>
