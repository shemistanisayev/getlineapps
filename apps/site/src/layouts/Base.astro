---
/** Shared shell of getlineapps.com: head (SEO, fonts), skip link, consent banner. */
import '@line/ui/fonts.css';
import '../styles/base.css';
import interLatin from '@line/ui/fonts/inter-latin-wght-normal.woff2?url';
import jakartaLatin from '@line/ui/fonts/plus-jakarta-sans-latin-wght-normal.woff2?url';
import interCyrillic from '@line/ui/fonts/inter-cyrillic-wght-normal.woff2?url';
import { consentDefaultsScript, renderSeoHead, type SeoInput } from '@line/site-kit';
import { getShared, getTools, localePath, type Locale } from '../lib/site.ts';

interface Props {
  locale: Locale;
  seo: Omit<SeoInput, 'locale'>;
  /** Class on <body>, sets the page's own styles. */
  page: string;
}
const { locale, seo, page } = Astro.props;
const t = await getShared(locale);
const gtmId = (import.meta.env.PUBLIC_GTM_ID as string | undefined)?.trim() || '';
const head = renderSeoHead({
  image: '/og/line-apps.png',
  ...seo,
  locale,
});
// Store URL -> tool slug, so install clicks name the right tool on any page.
const stores = JSON.stringify(
  Object.fromEntries((await getTools()).filter((x) => x.storeUrl).map((x) => [x.storeUrl, x.slug])),
);
const notFound = page.split(' ').includes('nf');
// Russian and Ukrainian pages: Inter's Cyrillic (Plus Jakarta Sans has none, so headings fall back to Inter).
// Site only, so the extension bundles stay as they are. Loaded only when Cyrillic text is on the page.
const cyrillicFace = `@font-face{font-family:'Inter';font-style:normal;font-display:swap;font-weight:100 900;src:url('${interCyrillic}') format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}`;
const consentTexts = JSON.stringify({
  text: t.consent.text,
  accept: t.consent.accept,
  reject: t.consent.reject,
  privacyLabel: t.consent.privacyLabel,
  privacyHref: localePath(locale, '/privacy/hitline'),
});
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#120D24" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={cyrillicFace}></style>
    {gtmId && <script is:inline set:html={consentDefaultsScript()} />}
    <Fragment set:html={head} />
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body
    class={page}
    data-gtm={gtmId || undefined}
    data-consent={gtmId ? consentTexts : undefined}
    data-stores={gtmId ? stores : undefined}
    data-not-found={gtmId && notFound ? '' : undefined}
  >
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <slot />
    {gtmId && <script>
      import '@line/site-kit/consent.css';
      import { mountConsentBanner } from '@line/site-kit/consent';
      import { initAnalytics } from '@line/site-kit/analytics';
      const body = document.body;
      initAnalytics({
        stores: JSON.parse(body.dataset.stores ?? '{}'),
        notFound: body.hasAttribute('data-not-found'),
      });
      const gtmId = body.dataset.gtm ?? '';
      const texts = JSON.parse(body.dataset.consent ?? '{}');
      mountConsentBanner({ gtmId, texts });
      document.querySelectorAll('[data-cookie-settings]').forEach((el) =>
        el.addEventListener('click', (e) => {
          e.preventDefault();
          mountConsentBanner({ gtmId, texts, force: true })?.querySelector('button')?.focus();
        }),
      );
    </script>}
  </body>
</html>
