---
/** /<lang>/rivaline for the languages beyond EN and AZ (lib/site.ts, EXTRA_LOCALES). */
import RivalinePage from '../../components/RivalinePage.astro';
import { EXTRA_LOCALES, type Locale } from '../../lib/site.ts';

export function getStaticPaths() {
  return EXTRA_LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
---

<RivalinePage locale={locale} />
