---
/** /<lang> for the languages beyond EN and AZ (lib/site.ts, EXTRA_LOCALES). */
import HubPage from '../../components/HubPage.astro';
import { EXTRA_LOCALES, type Locale } from '../../lib/site.ts';

export function getStaticPaths() {
  return EXTRA_LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
---

<HubPage locale={locale} />
