{
  "name": "@line/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./brand": "./src/brand.ts",
    "./marks": "./src/marks.ts",
    "./glyphs": "./src/glyphs.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./ui.css": "./src/ui.css",
    "./serpline": "./src/serpline/index.ts",
    "./serpline.css": "./src/serpline/serpline.css",
    "./fonts/*": "./fonts/*",
    "./icons/*": "./icons/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview --port 4310 --strictPort",
